---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Iannuzzi Data — Serie A Intelligence">
  <main class="min-h-screen bg-[#0f172a] text-slate-100 px-6 py-12 max-w-7xl mx-auto">
    
    <!-- Hero Section -->
    <header class="text-center py-16 border-b border-slate-800">
      <span class="text-sky-400 font-mono text-sm tracking-widest uppercase">Serie A Intelligence • Season 26/27</span>
      <h1 class="text-5xl font-extrabold tracking-tight mt-4 bg-gradient-to-r from-white via-slate-200 to-sky-400 bg-clip-text text-transparent">
        IANNUZZI DATA
      </h1>
      <p class="text-slate-400 mt-4 max-w-2xl mx-auto text-lg">
        Análisis táctico avanzado, modelos probabilísticos de xG y cobertura analítica en tiempo real.
      </p>
      <div class="mt-8 flex justify-center gap-4">
        <a href="#analisis" class="bg-sky-500 hover:bg-sky-400 text-slate-950 font-bold px-6 py-3 rounded-lg transition-all">
          Explorar Análisis
        </a>
        <a href="#recursos" class="border border-slate-700 hover:border-slate-500 px-6 py-3 rounded-lg font-medium transition-all">
          Ebooks & Datasets
        </a>
      </div>
    </header>

    <!-- Metrics Dashboard -->
    <section class="py-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="bg-[#1e293b] p-6 rounded-xl border border-slate-800">
        <h3 class="text-slate-400 text-sm uppercase font-mono">Líder Expected Points (xP)</h3>
        <p class="text-2xl font-bold text-white mt-2">Inter de Milán</p>
        <span class="text-emerald-400 text-xs font-mono">+4.2 xG Dif. respecto al promedio</span>
      </div>
      <div class="bg-[#1e293b] p-6 rounded-xl border border-slate-800">
        <h3 class="text-slate-400 text-sm uppercase font-mono">Presión Más Alta (PPDA)</h3>
        <p class="text-2xl font-bold text-white mt-2">Atalanta (8.1)</p>
        <span class="text-sky-400 text-xs font-mono">Pases permitidos por acción defensiva</span>
      </div>
      <div class="bg-[#1e293b] p-6 rounded-xl border border-slate-800">
        <h3 class="text-slate-400 text-sm uppercase font-mono">Efectividad a Balón Parado</h3>
        <p class="text-2xl font-bold text-white mt-2">Juventus (34%)</p>
        <span class="text-emerald-400 text-xs font-mono">Goles derivados de tiros de esquina</span>
      </div>
    </section>

    <!-- Feed de Análisis Automatizados (n8n) -->
    <section id="analisis" class="py-12 border-t border-slate-800">
      <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-sky-400 animate-pulse"></span>
        Últimos Análisis Tácticos
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- Tarjeta generada desde el flujo de n8n -->
        <a href="/analisis-inter-vs-monza" class="group bg-[#1e293b] p-6 rounded-xl border border-slate-800 hover:border-sky-500/50 transition-all">
          <span class="text-xs font-mono text-sky-400">Matchday Preview</span>
          <h3 class="text-xl font-bold mt-2 group-hover:text-sky-400 transition-colors">Inter vs. Monza — Desglose Táctico & xG</h3>
          <p class="text-slate-400 text-sm mt-2 line-clamp-2">
            Análisis profundo de bloques defensivos, métricas de creación de oportunidades y predicción probabilística.
          </p>
          <span class="inline-block mt-4 text-xs font-mono text-slate-500">Leer análisis completo →</span>
        </a>

      </div>
    </section>

  </main>
</Layout>